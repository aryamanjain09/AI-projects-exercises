# Copy this to .env and fill in your values

# PostgreSQL
POSTGRES_USER=bloodreport
POSTGRES_PASSWORD=bloodreport
POSTGRES_DB=bloodreportdb

# Backend security - generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Anthropic - get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET_NAME=blood-reports

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Parsing confidence threshold (0.0-1.0) - metrics below this are flagged for review
CONFIDENCE_THRESHOLD=0.85
